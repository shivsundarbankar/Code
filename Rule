{
    "outputFormat": "BUSINESS_JSON",
    "rules": [
      { "type": "SEGMENT_FIELD", "segment": "BEG", "position": 3,  "field": "poNumber" },
      { "type": "SEGMENT_FIELD", "segment": "BEG", "position": 5,  "field": "poDate" },
      { "type": "SEGMENT_FIELD", "segment": "CUR", "position": 2,  "field": "currency" },
      { "type": "SEGMENT_FIELD", "segment": "REF", "position": 2,  "field": "vendorNumber" },
      { "type": "SEGMENT_FIELD", "segment": "PER", "position": 2,  "field": "buyerContact" },
      { "type": "SEGMENT_FIELD", "segment": "ITD", "position": 3,  "field": "terms.discountPercent" },
      { "type": "SEGMENT_FIELD", "segment": "ITD", "position": 5,  "field": "terms.netDays" },
      { "type": "SEGMENT_FIELD", "segment": "ITD", "position": 12, "field": "terms.description" },
      { "type": "SEGMENT_FIELD", "segment": "DTM", "position": 2,  "field": "cancelDate" },

      { "type": "LOOP_FIELD", "loopTrigger": "N1",
        "filterSegment": "N1", "filterPosition": 1, "filterValue": "ST",
        "segment": "N1", "position": 2, "field": "shipTo.name" },
      { "type": "LOOP_FIELD", "loopTrigger": "N1",
        "filterSegment": "N1", "filterPosition": 1, "filterValue": "ST",
        "segment": "N1", "position": 4, "field": "shipTo.locationCode" },
      { "type": "LOOP_FIELD", "loopTrigger": "N1",
        "filterSegment": "N1", "filterPosition": 1, "filterValue": "ST",
        "segment": "N3", "position": 1, "field": "shipTo.street" },
      { "type": "LOOP_FIELD", "loopTrigger": "N1",
        "filterSegment": "N1", "filterPosition": 1, "filterValue": "ST",
        "segment": "N4", "position": 1, "field": "shipTo.city" },
      { "type": "LOOP_FIELD", "loopTrigger": "N1",
        "filterSegment": "N1", "filterPosition": 1, "filterValue": "ST",
        "segment": "N4", "position": 2, "field": "shipTo.state" },
      { "type": "LOOP_FIELD", "loopTrigger": "N1",
        "filterSegment": "N1", "filterPosition": 1, "filterValue": "ST",
        "segment": "N4", "position": 3, "field": "shipTo.zip" },

      { "type": "LOOP_FIELD", "loopTrigger": "N1",
        "filterSegment": "N1", "filterPosition": 1, "filterValue": "VN",
        "segment": "N1", "position": 2, "field": "vendor.name" },
      { "type": "LOOP_FIELD", "loopTrigger": "N1",
        "filterSegment": "N1", "filterPosition": 1, "filterValue": "VN",
        "segment": "N3", "position": 1, "field": "vendor.street" },
      { "type": "LOOP_FIELD", "loopTrigger": "N1",
        "filterSegment": "N1", "filterPosition": 1, "filterValue": "VN",
        "segment": "N4", "position": 1, "field": "vendor.city" },
      { "type": "LOOP_FIELD", "loopTrigger": "N1",
        "filterSegment": "N1", "filterPosition": 1, "filterValue": "VN",
        "segment": "N4", "position": 2, "field": "vendor.state" },

      {
        "type": "LOOP_ARRAY",
        "loopTrigger": "PO1",
        "arrayField": "lineItems",
        "itemRules": [
          { "segment": "PO1", "position": 1,  "field": "lineNumber" },
          { "segment": "PO1", "position": 2,  "field": "quantityOrdered" },
          { "segment": "PO1", "position": 3,  "field": "unitOfMeasure" },
          { "segment": "PO1", "position": 4,  "field": "unitPrice" },
          { "segment": "PO1", "position": 7,  "field": "skuNumber" },
          { "segment": "PO1", "position": 9,  "field": "vendorPartNumber" },
          { "segment": "PO1", "position": 11, "field": "upcCode" },
          { "segment": "PID", "position": 5,  "field": "productDescription" },
          { "segment": "PO4", "position": 1,  "field": "packSize" },
          { "segment": "SAC", "position": 5,  "field": "allowanceAmount" }
        ]
      }
    ]
  }
