{
    "outputFormat": "BUSINESS_JSON",
    "rules": [ 
      { "type": "SEGMENT_FIELD", "segment": "BSN", "position": 2, "field": "shipmentId" },
      { "type": "SEGMENT_FIELD", "segment": "BSN", "position": 3, "field": "shipmentDate" },
      { "type": "SEGMENT_FIELD", "segment": "BSN", "position": 4, "field": "shipmentTime" },                                               

      { "type": "LOOP_FIELD_NESTED",
        "loopChain": [{ "trigger": "HL", "filterPosition": 3, "filterValue": "S" }],
        "segment": "TD1", "position": 7, "field": "grossWeight" },
      { "type": "LOOP_FIELD_NESTED",
        "loopChain": [{ "trigger": "HL", "filterPosition": 3, "filterValue": "S" }],
        "segment": "TD1", "position": 8, "field": "weightUnit" },
      { "type": "LOOP_FIELD_NESTED",
        "loopChain": [{ "trigger": "HL", "filterPosition": 3, "filterValue": "S" }],
        "segment": "REF", "filterPosition": 1, "filterValue": "BM", "position": 2, "field": "billOfLading" },
      { "type": "LOOP_FIELD_NESTED",
        "loopChain": [{ "trigger": "HL", "filterPosition": 3, "filterValue": "S" }],
        "segment": "REF", "filterPosition": 1, "filterValue": "CN", "position": 2, "field": "proNumber" },
      { "type": "LOOP_FIELD_NESTED",
        "loopChain": [{ "trigger": "HL", "filterPosition": 3, "filterValue": "S" }],
        "segment": "DTM", "position": 2, "field": "shipDate" },
      { "type": "LOOP_FIELD_NESTED",
        "loopChain": [{ "trigger": "HL", "filterPosition": 3, "filterValue": "S" },
                      { "trigger": "N1", "filterPosition": 1, "filterValue": "ST" }],
        "segment": "N1", "position": 2, "field": "shipTo.name" },
      { "type": "LOOP_FIELD_NESTED",
        "loopChain": [{ "trigger": "HL", "filterPosition": 3, "filterValue": "S" },
                      { "trigger": "N1", "filterPosition": 1, "filterValue": "ST" }],
        "segment": "N3", "position": 1, "field": "shipTo.street" },
      { "type": "LOOP_FIELD_NESTED",
        "loopChain": [{ "trigger": "HL", "filterPosition": 3, "filterValue": "S" },
                      { "trigger": "N1", "filterPosition": 1, "filterValue": "ST" }],
        "segment": "N4", "position": 1, "field": "shipTo.city" },
      { "type": "LOOP_FIELD_NESTED",
        "loopChain": [{ "trigger": "HL", "filterPosition": 3, "filterValue": "S" },
                      { "trigger": "N1", "filterPosition": 1, "filterValue": "SF" }],
        "segment": "N1", "position": 2, "field": "shipFrom.name" },
      { "type": "LOOP_FIELD",
        "loopTrigger": "HL",
        "filterSegment": "HL", "filterPosition": 3, "filterValue": "O",
        "segment": "PRF", "position": 1, "field": "purchaseOrderNumber" },
      { "type": "LOOP_FIELD",
        "loopTrigger": "HL",
        "filterSegment": "HL", "filterPosition": 3, "filterValue": "O",
        "segment": "PRF", "position": 4, "field": "purchaseOrderDate" },
      {
        "type": "LOOP_ARRAY",
        "loopTrigger": "HL",
        "filterSegment": "HL", "filterPosition": 3, "filterValue": "I",
        "arrayField": "lineItems",
        "itemRules": [
          { "segment": "LIN", "position": 3,  "field": "vendorItemNumber"   },
          { "segment": "LIN", "position": 5,  "field": "internalItemNumber" },
          { "segment": "LIN", "position": 7,  "field": "upcCode"            },
          { "segment": "SN1", "position": 2,  "field": "shippedQuantity"    },
          { "segment": "SN1", "position": 3,  "field": "unitOfMeasure"      },
          { "segment": "PID", "position": 5,  "field": "productDescription" },
          { "segment": "DTM", "position": 2,  "field": "expiryDate"         }
        ]
      }
    ]
  }
